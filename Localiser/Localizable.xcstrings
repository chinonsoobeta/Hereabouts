    "Archive things you no longer own. They're hidden from search and don't count toward your free plan. You keep their history." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archive things you no longer own. They're hidden from search and don't count towards your free plan. You keep their history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiva los objetos que ya no tienes. Se ocultan en la búsqueda y no cuentan para tu plan gratuito. Conservas su historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivez les objets que vous n’avez plus. Ils sont masqués dans la recherche et ne comptent pas dans votre formule gratuite. Vous gardez leur historique."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquive objetos que você não tem mais. Eles somem da busca e não contam para o plano grátis. O histórico fica guardado."
