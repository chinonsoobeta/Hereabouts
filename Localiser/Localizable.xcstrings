    "Manual backups, reminders, Siri and Spotlight are free. Pro removes the limits and adds weekly backups." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manual backups, reminders, Siri and Spotlight are free. Pro removes the limits and adds weekly backups."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias manuales, los recordatorios, Siri y Spotlight son gratis. Pro quita los límites y añade copias semanales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sauvegardes manuelles, les rappels, Siri et Spotlight sont gratuits. Pro supprime les limites et ajoute des sauvegardes chaque semaine."
          }
        }
      }
    },
