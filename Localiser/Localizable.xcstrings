        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Se renueva automáticamente hasta que canceles. Cancela en Ajustes al menos un día antes de la renovación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
