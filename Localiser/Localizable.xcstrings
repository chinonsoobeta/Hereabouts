        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre abonnement a pris fin. Tout ce que vous avez enregistré est toujours là. Vous pouvez toujours le retrouver, le modifier et l’exporter."
          }
        }
