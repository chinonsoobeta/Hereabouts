          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha eliminado nada. Prueba a reiniciar tu iPhone. Si aún necesitas ayuda, guarda el archivo de tu libreta y envíalo a soporte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n’a été supprimé. Essayez de redémarrer votre iPhone. Si besoin, enregistrez le fichier de votre carnet et envoyez-le à l’assistance."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada foi apagado. Tente reiniciar seu iPhone. Se ainda precisar de ajuda, salve o arquivo do seu caderno e envie ao suporte."
