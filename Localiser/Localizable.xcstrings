            "state" : "translated",
            "value" : "Une date de cette sauvegarde est endommagée."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma data neste backup está danificada."
          }
        }
      }
    },
