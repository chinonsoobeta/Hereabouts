    "In Find, Places and Trips, you see your chosen home. Search, dates and reminders cover all homes. You can delete an empty home." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Find, Places and Trips, you see your chosen home. Search, dates and reminders cover all homes. You can delete an empty home."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Buscar, Lugares y Viajes ves la casa elegida. La búsqueda, las fechas y los recordatorios abarcan todas las casas. Puedes eliminar una casa vacía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans Chercher, Endroits et Voyages, vous voyez la maison choisie. La recherche, les dates et les rappels couvrent toutes les maisons. Vous pouvez supprimer une maison vide."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontrar, Lugares e Viagens mostram a casa escolhida. A busca, as datas e os lembretes valem para todas as casas. Você pode apagar uma casa vazia."
          }
        }
      }
    },
