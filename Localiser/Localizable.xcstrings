    "A backup" : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A backup"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una copia de seguridad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une sauvegarde"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um backup"
          }
        }
      }
    },
    "A backup holds your places, things, history, dates, kits and trips. You choose which photos and documents to include. Backups aren't encrypted. Anyone with the file can read it. Save it somewhere private, like iCloud Drive or Files on this iPhone." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A backup holds your places, things, history, dates, kits and trips. You choose which photos and documents to include. Backups aren't encrypted. Anyone with the file can read it. Save it somewhere private, like iCloud Drive or Files on this iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una copia de seguridad guarda tus lugares, objetos, historial, fechas, kits y viajes. Tú eliges qué fotos y documentos incluir. Las copias no están cifradas: cualquiera con el archivo puede leerlo. Guárdala en un sitio privado, como iCloud Drive o Archivos en este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une sauvegarde contient vos endroits, objets, historique, dates, kits et voyages. Vous choisissez les photos et documents à inclure. Les sauvegardes ne sont pas chiffrées : toute personne qui a le fichier peut le lire. Gardez-le en lieu sûr, par exemple dans iCloud Drive ou Fichiers sur cet iPhone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um backup guarda seus lugares, objetos, histórico, datas, kits e viagens. Você escolhe quais fotos e documentos incluir. Backups não são criptografados: qualquer pessoa com o arquivo pode lê-lo. Guarde-o em um lugar privado, como o iCloud Drive ou o app Arquivos neste iPhone."
          }
        }
      }
    },
    "A date in this backup is damaged." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A date in this backup is damaged."
