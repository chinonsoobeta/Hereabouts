    "Write down where you keep things. Find them later. Your notebook is saved on this iPhone. You don't need an account." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write down where you keep things. Find them later. Your notebook is saved on this iPhone. You don't need an account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anota dónde guardas tus cosas. Encuéntralas después. Tu libreta se guarda en este iPhone. No necesitas una cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notez où vous rangez vos affaires. Retrouvez-les plus tard. Votre carnet est enregistré sur cet iPhone. Aucun compte nécessaire."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anote onde você guarda suas coisas. Encontre-as depois. Seu caderno fica neste iPhone. Não precisa de conta."
          }
        }
      }
