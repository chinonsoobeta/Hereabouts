    "Find something" : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find something"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buscar algo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chercher quelque chose"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontrar algo"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can take a photo of a thing or shelf, or scan a box label. Your photos stay on this device."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can take a photo of a thing or shelf, or scan a box label. Your photos stay on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes hacer una foto de un objeto o un estante, o escanear la etiqueta de una caja. Tus fotos se quedan en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez photographier un objet ou une étagère, ou scanner l’étiquette d’une boîte. Vos photos restent sur cet appareil."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode tirar uma foto de um objeto ou de uma prateleira, ou escanear a etiqueta de uma caixa. Suas fotos ficam neste dispositivo."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the microphone to say where you keep a thing. Hold to talk, and let go when you're done. Nothing is recorded."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the microphone to say where you keep a thing. Hold to talk, and let go when you're done. Nothing is recorded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el micrófono para decir dónde guardas un objeto. Mantén pulsado para hablar y suelta al terminar. No se graba nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez le micro pour dire où vous rangez un objet. Maintenez pour parler et relâchez quand vous avez fini. Rien n’est enregistré."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o microfone para dizer onde guarda um objeto. Mantenha pressionado para falar e solte quando terminar. Nada é gravado."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can add a photo to show what a thing looks like. Hereabouts uses only the photos you choose."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can add a photo to show what a thing looks like. Hereabouts uses only the photos you choose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes añadir una foto para mostrar cómo es un objeto. Hereabouts solo usa las fotos que eliges."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez ajouter une photo pour montrer à quoi ressemble un objet. Hereabouts n’utilise que les photos que vous choisissez."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode adicionar uma foto para mostrar como é um objeto. O Hereabouts usa apenas as fotos que você escolhe."
          }
        }
      }
    },
