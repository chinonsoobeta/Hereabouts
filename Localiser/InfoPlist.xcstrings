    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can take a photo of a thing or shelf, or scan a box label. Your photos stay on this iPhone."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can take a photo of a thing or shelf, or scan a box label. Your photos stay on this iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes hacer una foto de un objeto o un estante, o escanear la etiqueta de una caja. Tus fotos se quedan en este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez photographier un objet ou une étagère, ou scanner l’étiquette d’une boîte. Vos photos restent sur cet iPhone."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use the microphone to say where you keep a thing. Hold to talk, or tap to start and stop. Nothing is recorded."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the microphone to say where you keep a thing. Hold to talk, or tap to start and stop. Nothing is recorded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el micrófono para decir dónde guardas un objeto. Mantén pulsado para hablar, o toca para empezar y parar. No se graba nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez le micro pour dire où vous rangez un objet. Maintenez pour parler, ou touchez pour commencer et arrêter. Rien n’est enregistré."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can add a photo to show what a thing looks like. Hereabouts uses only the photos you choose."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can add a photo to show what a thing looks like. Hereabouts uses only the photos you choose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes añadir una foto para mostrar cómo es un objeto. Hereabouts solo usa las fotos que eliges."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez ajouter une photo pour montrer à quoi ressemble un objet. Hereabouts n’utilise que les photos que vous choisissez."
          }
        }
      }
    },
